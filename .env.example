# Create the private configuration with install.sh (docs/install.md).
# See docs/install.md. This file lists required keys and optional settings you may add.

# Required: generated AMI secret (also used by Asterisk).
PHONELET_AMI_SECRET=GENERATE_SECRET
# Required: generated key for protected HTTP API requests.
PHONELET_API_KEY=GENERATE_KEY
# Required: generated SIP phone password (at least 12 characters).
AST_SIP_PASSWORD=GENERATE_PASSWORD
# Required: country calling code with a leading +.
AST_COUNTRY_PREFIX=
# Optional: one domestic trunk-prefix digit, replaced only from six dialed digits; empty if there is none.
AST_TRUNK_PREFIX=
# Required: address or DNS name by which the SIP phone reaches this host; also the SMS sender domain.
PHONELET_SIP_DOMAIN=

# Telegram (set both; empty disables the channel). Token/chat ID: docs/install.md.
#PHONELET_TELEGRAM_TOKEN=
#PHONELET_TELEGRAM_CHAT_ID=

# Home Assistant (set both; empty disables the channel). Access token: docs/install.md.
#PHONELET_HA_URL=
#PHONELET_HA_TOKEN=

# Encrypted SMS commands (docs/sms-commands.md): empty key disables commands.
# Generate the key with: PYTHONPATH=src .venv/bin/python -m phonelet.sms_commands key
#PHONELET_SMS_COMMAND_KEY=
# Wi-Fi command settings (bootstrap packages are selected separately).
#PHONELET_WIFI_NETPLAN_FILE=/etc/netplan/30-wifis-dhcp.yaml
#PHONELET_WIFI_INTERFACE=wlan0
#PHONELET_WIFI_STATE_DIR=/var/lib/phonelet/wifi
#PHONELET_WIFI_CONNECT_TIMEOUT=120

# Call recording: enable only where lawful and after obtaining any required consent.
#AST_RECORD_CALLS=no

# Audio gains: integers -32767..32767; 0 is neutral. RX: GSM to SIP; TX: SIP to GSM.
#AST_DONGLE_RXGAIN=0
#AST_DONGLE_TXGAIN=0

# Modem ports: data= uses PCUI (USB interface 02); audio= uses interface 01.
# /dev/dongle0-at carries AT replies and notifications; /dev/dongle0-modem is the unused modem (MDM) port, never data=.
#AST_DONGLE_DATA=/dev/dongle0-at
#AST_DONGLE_AUDIO=/dev/dongle0-audio

# SIP authentication username and incoming SMS destination (empty destination disables SIP SMS).
#AST_SIP_USERNAME=phone
#PHONELET_SIP_MESSAGE_DESTINATION=pjsip:phone
# SIP UDP listen address: IPv4 with an optional port. Only an address present at boot (a static LAN
# address); with DHCP or Tailscale keep 0.0.0.0 and use the firewall (docs/install.md, Firewall).
# A change needs a deploy with --allow-asterisk-restart.
#AST_SIP_BIND=0.0.0.0:5060

# HTTP API bind address and port.
#PHONELET_API_HOST=127.0.0.1
#PHONELET_API_PORT=8080

# Tuning: seconds; all intervals and disk reserve must be positive.
#PHONELET_MODEM_POLL_INTERVAL=30
#PHONELET_INGRESS_POLL_INTERVAL=5
# Incomplete multipart SMS is published after this timeout; late parts update and notify again.
#PHONELET_SMS_REASSEMBLY_TIMEOUT=600
#PHONELET_AMI_RECONNECT_TIMEOUT=5
# Disk reserve: 100 MiB; recording conversion also needs room for the WAV input.
#PHONELET_MIN_FREE_BYTES=104857600
#PHONELET_LOG_LEVEL=INFO
#PHONELET_DB_PATH=/var/lib/phonelet/phonelet.db
#PHONELET_RECORDINGS_DIR=/var/lib/phonelet/recordings
# Delete recordings of calls older than this many days; 0 keeps them forever.
#PHONELET_RECORDING_RETENTION_DAYS=0
