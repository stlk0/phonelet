+/*!
+ * \brief Phonelet: queue AT+CPMS for an SMS memory
+ * \param cpvt -- cpvt structure
+ * \param mem -- PHONELET_MEM_SM or PHONELET_MEM_ME to read and delete; with
+ * PHONELET_MEM_ALL also to write and receive
+ * \param athead -- queue after the head task, before the reads already queued
+ *
+ * Without PHONELET_MEM_ALL only <mem1> changes: the modem keeps receiving
+ * into the memory set before, ME, and keeps that one across power cycles.
+ */
+EXPORT_DEF void phonelet_storage_select(struct cpvt *cpvt, unsigned int mem, int athead)
+{
+	pvt_t *pvt = cpvt->pvt;
+	const char *name = PHONELET_MEM_NAME(mem);
+	at_queue_cmd_t cmds[] = {
+		ATQ_CMD_DECLARE_DYN(CMD_AT_CPMS_SELECT),
+	};
+	int err;
+
+	if (mem & PHONELET_MEM_ALL)
+		err = at_fill_generic_cmd(&cmds[0], "AT+CPMS=\"%s\",\"%s\",\"%s\"\r", name, name, name);
+	else
+		err = at_fill_generic_cmd(&cmds[0], "AT+CPMS=\"%s\"\r", name);
+	if (err || at_queue_insert(cpvt, cmds, ITEMS_OF(cmds), athead))
+	{
+		ast_log(LOG_ERROR, "[%s] Error queueing SMS storage %s\n", PVT_ID(pvt), name);
+		/* A pass (startup or periodic) cannot go on: next one after the interval */
+		if (pvt->phonelet_rescan_active)
+		{
+			struct timespec now;
+			clock_gettime(CLOCK_MONOTONIC, &now);
+			pvt->phonelet_rescan_active = 0;
+			pvt->phonelet_rescan_end = now.tv_sec;
+			ast_log(LOG_WARNING, "[%s] SMS rescan stopped: storage selection not sent\n", PVT_ID(pvt));
+		}
+		return;
+	}
+	pvt->phonelet_counts_valid = 0;
+	pvt->phonelet_mem_switch = mem;
+}
+
+/*!
+ * \brief Phonelet: select the next SMS memory to read once the inbox is idle
+ * \param cpvt -- cpvt structure
+ *
+ * SMS are received into ME. A memory a +CMTI named while another one was
+ * read is selected next and read in full, then reading returns to ME,
+ * unless the modem rejected ME and no +CMTI named ME since.
+ * AT+CPMS is queued only with no read in flight and no slot waiting, so the
+ * FIFO queue sends it after the CMGR and CMGD of the previous memory.
+ */
+EXPORT_DEF void phonelet_storage_next(struct cpvt *cpvt)
+{
+	pvt_t *pvt = cpvt->pvt;
+	unsigned int mem, i;
+
+	if (pvt->phonelet_mem_switch || pvt->incoming_sms_index != -1U)
+		return;
+	for (i = 0; i != SMS_INDEX_MAX; i++)
+	{
+		if (is_sms_inbox_set(pvt, i))
+			return;
+	}
+
+	mem = pvt->phonelet_mem_pending & ~pvt->phonelet_mem_failed & ~pvt->phonelet_mem;
+	if (!mem && pvt->phonelet_mem != PHONELET_MEM_ME && !(pvt->phonelet_mem_failed & PHONELET_MEM_ME))
+		mem = PHONELET_MEM_ME;
+	if (mem)
+		phonelet_storage_select(cpvt, mem, 0);
 }
 
