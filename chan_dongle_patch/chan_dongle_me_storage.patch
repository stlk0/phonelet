+/* Only the first pair describes the memory used for CMGR/CMGD; its total
+ * bounds the full read. Ignore unsolicited, missing or malformed counts; the
+ * fallback is all 256 slots. */
+static void phonelet_storage_counts(struct pvt *pvt, const char *str)
+{
+	const at_queue_cmd_t *cmd = at_queue_head_cmd(pvt);
+	int used, total, end = 0;
+	if (!cmd || (cmd->cmd != CMD_AT_CPMS && cmd->cmd != CMD_AT_CPMS_SELECT))
+		return;
+	pvt->phonelet_counts_valid = 0;
+	if (sscanf(str, "+CPMS: %9d , %9d %n", &used, &total, &end) != 2 || !end
+	    || (str[end] && str[end] != ',') || used < 0 || total < 0
+	    || used > total || total > SMS_INDEX_MAX)
+		return;
+	pvt->phonelet_total = total;
+	pvt->phonelet_counts_valid = 1;
+}
