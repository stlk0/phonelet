+/* Called with the monitor lock. No catch-up: one pass per interval measured
+ * from completion, including a rejected selection. Never start over live work. */
+static void phonelet_rescan_tick(struct pvt *pvt)
+{
+	struct timespec now;
+	unsigned int i;
+
+	if (at_queue_head_cmd(pvt) || pvt->incoming_sms_index != -1U)
+		return;
+	for (i = 0; i < SMS_INDEX_MAX; i++)
+	{
+		if (!is_sms_inbox_set(pvt, i))
+			continue;
+		/* A slot waits with nothing queued: its read was not queued or not
+		 * written. The journal retry path reads it again. */
+		if (!pvt->phonelet_retry_at)
+			pvt->phonelet_retry_at = phonelet_monotonic() + 30;
+		return;
+	}
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	if (pvt->phonelet_rescan_active)
+	{
+		pvt->phonelet_rescan_active = 0;
+		pvt->phonelet_rescan_end = now.tv_sec;
+		ast_log(LOG_NOTICE, "[%s] SMS rescan finished: SM=%u ME=%u\n", PVT_ID(pvt),
+		    pvt->phonelet_rescan_sm, pvt->phonelet_rescan_me);
+		return;
+	}
+	/* A call has a channel. ring can stay set without one (a missed call):
+	 * only a recent RING counts. dialing and cwaiting are not used: they can stick too. */
+	if (!pvt->initialized || !pvt->has_sms || CONF_SHARED(pvt, disablesms)
+	    || !PVT_NO_CHANS(pvt)
+	    || (pvt->ring && now.tv_sec - pvt->phonelet_ring_at < PHONELET_RING_WINDOW)
+	    || now.tv_sec - pvt->phonelet_rescan_end < PHONELET_RESCAN_INTERVAL)
+		return;
+	pvt->phonelet_rescan_active = 1;
+	pvt->phonelet_rescan_polled = 0;
+	pvt->phonelet_rescan_sm = pvt->phonelet_rescan_me = 0;
+	pvt->phonelet_mem_failed = 0;
+	ast_log(LOG_NOTICE, "[%s] SMS rescan started: SM=0 ME=0\n", PVT_ID(pvt));
+	/* Not queued or not written: the pass stops there (phonelet_storage_select) */
+	phonelet_storage_select(&pvt->sys_chan, PHONELET_MEM_SM, 0);
+}
