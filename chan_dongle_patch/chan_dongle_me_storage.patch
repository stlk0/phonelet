+/*!
+ * \brief Phonelet: result of AT+CPMS="ME","ME","ME" in the init list
+ * \param pvt -- pvt structure
+ * \param ok -- the modem answered OK
+ *
+ * After OK the SIM is read first: AT+CPMS="SM" changes only the memory to
+ * read, so SMS keep arriving in ME, and it is queued before the full read
+ * that follows the init list. After an error SMS stays enabled on the SIM,
+ * for read, write and receive.
+ */
+static void phonelet_storage_init(struct pvt *pvt, int ok)
+{
+	if (!ok)
+	{
+		pvt->phonelet_mem_failed |= PHONELET_MEM_ME;
+		ast_log(LOG_WARNING, "[%s] Modem rejected SMS storage ME, keeping SM\n", PVT_ID(pvt));
+		phonelet_storage_select(&pvt->sys_chan, PHONELET_MEM_SM | PHONELET_MEM_ALL, 1);
+		return;
+	}
+	pvt->phonelet_mem = PHONELET_MEM_ME;
+	ast_log(LOG_NOTICE, "[%s] SMS storage ME selected for read, write and receive\n", PVT_ID(pvt));
+	if (!CONF_SHARED(pvt, disablesms))
+		phonelet_storage_select(&pvt->sys_chan, PHONELET_MEM_SM, 1);
+}
+
+/*!
+ * \brief Phonelet: result of a queued AT+CPMS selection
+ * \param pvt -- pvt structure
+ * \param ok -- the modem answered OK
+ *
+ * After OK the selected memory is read in full. After an error the modem
+ * keeps the memory selected before, and SMS stays enabled there; that memory
+ * is read in full again if a +CMTI named it while the selection was queued,
+ * or if the startup or periodic pass has read no memory yet. The memory
+ * rejected is selected again for a +CMTI naming it or by the next pass.
+ */
+static void phonelet_storage_selected(struct pvt *pvt, int ok)
+{
+	unsigned int request = pvt->phonelet_mem_switch;
+	unsigned int mem = request & (PHONELET_MEM_SM | PHONELET_MEM_ME);
+	const char *scope = request & PHONELET_MEM_ALL ? "read, write and receive" : "reading";
+
+	pvt->phonelet_mem_switch = 0;
+	pvt->phonelet_mem_pending &= ~mem;
+	if (!mem)
+		return;
+	if (ok)
+	{
+		pvt->phonelet_mem = mem;
+		pvt->phonelet_rescan_polled = 1;
+		ast_log(LOG_NOTICE, "[%s] SMS storage %s selected for %s\n", PVT_ID(pvt), PHONELET_MEM_NAME(mem), scope);
+		if (!CONF_SHARED(pvt, disablesms) && at_poll_sms(pvt))
+			ast_log(LOG_ERROR, "[%s] Error reading SMS storage %s\n", PVT_ID(pvt), PHONELET_MEM_NAME(mem));
+		return;
+	}
+	/* The SIM after a rejected ME stays the memory read: it is not marked */
+	if (!(request & PHONELET_MEM_ALL))
+		pvt->phonelet_mem_failed |= mem;
+	ast_log(LOG_WARNING, "[%s] Modem rejected SMS storage %s for %s, keeping %s\n", PVT_ID(pvt),
+	    PHONELET_MEM_NAME(mem), scope, PHONELET_MEM_NAME(pvt->phonelet_mem));
+	/* Read the memory kept in full: a +CMTI named it meanwhile, or this
+	 * startup or periodic pass has read nothing yet. Once, no retry. */
+	if ((pvt->phonelet_mem_pending & pvt->phonelet_mem)
+	    || (pvt->phonelet_rescan_active && !pvt->phonelet_rescan_polled))
+	{
+		pvt->phonelet_mem_pending &= ~pvt->phonelet_mem;
+		pvt->phonelet_rescan_polled = 1;
+		if (!CONF_SHARED(pvt, disablesms) && at_poll_sms(pvt))
+			ast_log(LOG_ERROR, "[%s] Error reading SMS storage %s\n", PVT_ID(pvt), PHONELET_MEM_NAME(pvt->phonelet_mem));
+		return;
+	}
+	phonelet_storage_next(&pvt->sys_chan);
+}
+
+/*!
+ * \brief Phonelet: memory named by +CMTI: <mem>,<index>
+ * \return PHONELET_MEM_SM, PHONELET_MEM_ME, or 0 for another name
+ */
+static unsigned int phonelet_storage_parse(const char *str)
+{
+	const char *name = strchr(str, ':');
+	unsigned int mem;
+
+	if (!name)
+		return 0;
+	name += 1 + strspn(name + 1, " ");
+	if (*name == '"')
+		name++;
+	if (!strncasecmp(name, "SM", 2))
+		mem = PHONELET_MEM_SM;
+	else if (!strncasecmp(name, "ME", 2))
+		mem = PHONELET_MEM_ME;
+	else
+		return 0;
+	name += 2;
+	if (*name == '"')
+		name++;
+	name += strspn(name, " ");
+	return *name == ',' ? mem : 0;
+}
+
+/*!
+ * \brief Phonelet: read a +CMTI slot only from the memory it names
+ * \param pvt -- pvt structure
+ * \param str -- the +CMTI line, without SMS content
+ * \param index -- slot in that memory
+ * \retval  0 success
+ * \retval -1 the read could not be queued
+ *
+ * A slot of the memory being read is read at once. Another memory waits:
+ * it is selected for reading when the inbox is idle and read in full, then
+ * reading returns to ME. This covers "ME" while the SIM is read and "SM"
+ * for an SMS the modem still stores on the SIM. A memory being selected is
+ * read in full anyway. A memory the modem rejected is selected again, once
+ * for each +CMTI naming it. A slot of another memory never enters the
+ * inbox, so CMGR and CMGD of one memory never use the other's slot.
+ */
+static int phonelet_storage_notice(struct pvt *pvt, const char *str, int index)
+{
+	unsigned int mem = phonelet_storage_parse(str);
+
+	if (!mem)
+	{
+		ast_log(LOG_WARNING, "[%s] New SMS in slot %d of a memory that is not read; it stays there\n", PVT_ID(pvt), index);
+		return 0;
+	}
+	/* A rejected memory gets one more selection for this SMS */
+	pvt->phonelet_mem_failed &= ~mem;
+	if (!pvt->phonelet_mem_switch && mem == pvt->phonelet_mem)
+		return at_enqueue_retrieve_sms(&pvt->sys_chan, index, SUPPRESS_ERROR_DISABLED);
+	pvt->phonelet_mem_pending |= mem;
+	phonelet_storage_next(&pvt->sys_chan);
+	return 0;
+}
