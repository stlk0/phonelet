Guard late or extra ERROR and +CMGS replies without a matching task.

Source: aster (https://github.com/Sheepsticked/aster), commit 65e5a21,
docker/asterisk/patches/0013-chan-dongle-unexpected-error.patch.
Author: Sheepsticked. License: GPL-2.0 (same as chan_dongle).
Ported by meaning to chan_dongle 7db8e75 after ingress and Base64:
the source line numbers differ; keep the existing response handling unchanged.
Also ignore late +CMGS unless the queue head is a CMGS send task in
its SMSTEXT phase after the prompt; a command deadline may already
have removed the original task.
--- a/at_response.c
+++ b/at_response.c
@@ -296,7 +296,8 @@
 	va_list ap;
 	char tempbuff[512];
 
-	if (at_cmd_suppress_error_mode(ecmd->flags) == SUPPRESS_ERROR_ENABLED) {
+	/* an error with no command waiting for it (a late or extra answer) has no flags to read */
+	if (ecmd && at_cmd_suppress_error_mode(ecmd->flags) == SUPPRESS_ERROR_ENABLED) {
 		if (DEBUG_ATLEAST(1)) {
 			ast_log(AST_LOG_DEBUG, "[%s] Command response error suppressed:\n", PVT_ID(pvt));
 			va_start(ap, fmt);
@@ -1891,6 +1892,11 @@
 
 			case RES_CMGS:
 				{
+					if (!task || !ecmd || task->cmds[0].cmd != CMD_AT_CMGS
+					    || ecmd->cmd != CMD_AT_SMSTEXT) {
+						ast_log(LOG_WARNING, "[%s] Unexpected +CMGS without a pending SMS send; ignoring\n", PVT_ID(pvt));
+						return 0;
+					}
 					int res = at_parse_cmgs(str);
 
 					char payload[SMSDB_PAYLOAD_MAX_LEN];
