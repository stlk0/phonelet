+/* Phonelet fragment journal v1. No Asterisk dependencies: tested as standalone C.
+ * Directory must be provisioned on durable local storage, private to services.
+ * Success means file contents AND directory entry have reached fsync.
+ * Consumer never modifies these files. Retention requires a backed-up database.
+ * Tab-separated records, one newline-terminated record per immutable file:
+ * 1 <device hex> <sim hex> <stamp hex> <sender hex> <ref> <parts> <part>
+ *   <text hex (text_len bytes, including NUL)> <slot> <raw PDU hex>
+ * U1 <device hex> <sim hex> <slot> <raw PDU hex>
+ * NULL text selects U1: two failed reads of the same nonempty raw PDU, or a
+ * fragment the journal rejects.
+ * phonelet_spool returns PHONELET_SPOOL_OK, PHONELET_SPOOL_IO_ERROR (nothing
+ * published; retry later) or PHONELET_SPOOL_REJECTED (the record itself is
+ * invalid and never becomes valid: retrying cannot help).
+ */
+#ifndef PHONELET_INGRESS_H
+#define PHONELET_INGRESS_H
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <errno.h>
+#include <limits.h>
+#include <sys/stat.h>
+
+#define PHONELET_SPOOL_OK 0
+#define PHONELET_SPOOL_IO_ERROR (-1)
+#define PHONELET_SPOOL_REJECTED (-2)
+
+#ifndef PHONELET_SMS_SPOOL
+#define PHONELET_SMS_SPOOL "/var/spool/asterisk/phonelet-sms"
+#endif
+
+static int phonelet_hex(FILE *f, const char *s, size_t length)
+{
+    const unsigned char *p = (const unsigned char *)s;
+    for (size_t i = 0; i < length; ++i) {
+        if (fprintf(f, "%02x", p[i]) < 0) return -1;
+    }
+    return 0;
+}
+
+static int phonelet_spool(const char *dir, const char *device, const char *sim,
+    const char *stamp, const char *sender, int ref, int parts, int part,
+    const char *text, size_t text_len, unsigned slot, const char *pdu)
+{
+    char tmp[PATH_MAX] = "", final[PATH_MAX];
+    const char *fields[] = { device, sim, stamp, sender };
+    int fd = -1, dfd = -1, result = PHONELET_SPOOL_IO_ERROR, temporary = 0;
+    FILE *f = NULL;
+    if (parts < 1 || parts > 255 || part < 1 || part > parts) return PHONELET_SPOOL_REJECTED;
+    if (strlen(dir) + sizeof("/.fragment-XXXXXX.sms") > sizeof(tmp)) return PHONELET_SPOOL_IO_ERROR;
+    dfd = open(dir, O_RDONLY | O_DIRECTORY | O_NOFOLLOW);
+    if (dfd < 0) return PHONELET_SPOOL_IO_ERROR;
+    for (unsigned attempt = 0; attempt < 8; ++attempt) {
+        snprintf(tmp, sizeof(tmp), "%s/.fragment-XXXXXX", dir);
+        fd = mkstemp(tmp); /* mode 0600: spool parent is trusted and not world-writable */
+        if (fd < 0) goto done;
+        temporary = 1;
+        if (fchmod(fd, 0640)) { close(fd); goto done; } /* trusted shared service group */
+        f = fdopen(fd, "w");
+        if (!f) { close(fd); goto done; }
+        if (fprintf(f, "%s", text ? "1" : "U1") < 0) goto done;
+        for (unsigned i = 0; i < (text ? 4U : 2U); ++i) {
+            if (fputc('\t', f) == EOF || phonelet_hex(f, fields[i], strlen(fields[i]))) goto done;
+        }
+        if (text && (fprintf(f, "\t%d\t%d\t%d\t", ref, parts, part) < 0
+                     || phonelet_hex(f, text, text_len))) goto done;
+        if (fprintf(f, "\t%u\t%s\n", slot, pdu) < 0 || fflush(f) || fsync(fd)) goto done;
+        if (fclose(f)) { f = NULL; goto done; }
+        f = NULL;
+        memcpy(final, tmp, strlen(tmp));
+        memcpy(final + strlen(tmp), ".sms", 5);
+        /* Never replace a published record. A crash between link and unlink
+         * or a failed unlink may leave a temporary name without .sms; replay ignores it. */
+        if (link(tmp, final)) {
+            if (errno != EEXIST) goto done;
+            if (unlink(tmp)) goto done;
+            temporary = 0;
+            continue; /* bounded retry with a new mkstemp name */
+        }
+        (void)unlink(tmp); /* Publication succeeded; cleanup is best effort. */
+        temporary = 0;
+        if (fsync(dfd)) goto done;
+        result = PHONELET_SPOOL_OK;
+        break;
+    }
+done:
+    if (f) fclose(f);
+    if (temporary) unlink(tmp);
+    close(dfd);
+    return result;
+}
+#endif
