+/*!
+ * \brief Phonelet: queue AT after an SMS read answered without +CMGR
+ * \param cpvt -- cpvt structure
+ * \return 0 on success
+ *
+ * +CMGR carries no slot number: a reply belongs to a slot only by the order
+ * of the command queue. An OK or error taken for an inbox CMGR may be an
+ * extra or late answer to an earlier command, the CMGR's own +CMGR still on
+ * its way. The modem answers in order, so a +CMGR still due arrives before
+ * the reply to this AT, while no SMS read is at the head of the queue: it is
+ * ignored instead of being journaled as the next slot, whose SMS would then
+ * be deleted without ever reaching the journal.
+ */
+EXPORT_DEF int phonelet_enqueue_sms_sync(struct cpvt *cpvt)
+{
+	static const char cmd[] = "AT\r";
+	static at_queue_cmd_t at_cmd = ATQ_CMD_DECLARE_ST(CMD_AT_SMS_SYNC, cmd);
+
+	if (at_queue_insert_const(cpvt, &at_cmd, 1, 0) != 0) {
+		chan_dongle_err = E_QUEUE;
+		return -1;
+	}
+	return 0;
+}
