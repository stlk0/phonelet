+/* Received fragments may split a UTF-16 pair. Keep valid pairs, but replace
+ * lone surrogates so readable SMS reach the journal rather than quarantine.
+ * The strict conversion used by outgoing encoding and USSD is unchanged. */
+EXPORT_DEF ssize_t ucs2_to_utf8_lenient(const uint16_t *in, size_t in_length, char *out, size_t out_size)
+{
+    uint16_t clean[in_length ? in_length : 1];
+    unsigned char *bytes = (unsigned char *)clean;
+    memcpy(clean, in, in_length * 2);
+    for (size_t i = 0; i < in_length; ++i) {
+        unsigned unit = (bytes[i * 2] << 8) | bytes[i * 2 + 1];
+        if (unit < 0xD800 || unit > 0xDFFF) continue;
+        if (unit <= 0xDBFF && i + 1 < in_length) {
+            unsigned next = (bytes[i * 2 + 2] << 8) | bytes[i * 2 + 3];
+            if (next >= 0xDC00 && next <= 0xDFFF) { ++i; continue; }
+        }
+        bytes[i * 2] = 0xFF;
+        bytes[i * 2 + 1] = 0xFD;
+    }
+    return ucs2_to_utf8(clean, in_length, out, out_size);
+}
