+/* Phonelet: seconds of CLOCK_MONOTONIC for phonelet_retry_at, so that a
+ * wall-clock step (a board without RTC, NTP) does not move a retry. */
+static inline time_t phonelet_monotonic(void)
+{
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
